# [ Visual Studio ]
# 빌드 결과물 (Output)
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/
[Aa]rm/
[Aa]rm64/
bin/
obj/

# MSVC 증분 빌드 및 프리컴파일 헤더
*.pch
*.obj
*.ilk
*.pdb
*.tlog
*.lastbuildstate
*.idb
*.ipch
*.res
*.sbr
*.exp
*.lib
*.exe

# Visual Studio 솔루션 및 프로젝트 사용자 설정
.vs/
*.user
*.suo
*.ncb
*.opened
*.cache
*.db
*.opendb
*.sdf
*.sln.docqueries

# [ CMake ]
# CMake 빌드 폴더 및 생성물
/CMakeLists.txt.user
/CMakeCache.txt
/CMakeFiles/
/CMakeScripts/
/Testing/
/Makefile
/cmake_install.cmake
/install_manifest.txt
/compile_commands.json
/CTestTestfile.cmake
/cmake-build-*/

# [ 외부 라이브러리 및 패키지 매니저 ]
# vcpkg, NuGet 등
vcpkg_installed/
packages/
*.nuget.props
*.nuget.targets

# [ OS & 기타 ]
# Windows 썸네일 및 기타 시스템 파일
Thumbs.db
ehthumbs.db
Desktop.ini

# 임시 파일 및 백업
*.bak
*.tmp
*.swp
*~

# [ Claude Code ]
# 개인용 로컬 설정(권한 등) - 커밋 대상 아님
.claude/settings.local.json
# 크래시 덤프/로그 — 실행 중 생성되는 디버그 산출물
crash.dmp
crash.log

# [ 3D 벤더 에셋 ]
# CC0 외부 에셋 원본 255MB — 저장소에 넣지 않는다.
# 출처·라이선스는 world/manifest.json, 받는 절차는 README.md 참조.
# (디렉터리째 ignore 하면 git 이 내부로 내려가지 않아 아래 negation 이 무효가 된다)
assets/vendor/*
# 경로 규약을 남기기 위해 디렉터리 자체는 커밋한다.
!assets/vendor/.gitkeep

# [ Godot ]
# 임포트 캐시·빌드 산출물 — 프로젝트를 열면 재생성된다.
.godot/
# Client/assets 는 assets/vendor 로 향하는 정션이다.
# 막지 않으면 git 이 정션 너머 255MB 를 추적하려 든다.
Client/assets/
*.csproj.user

# [ Python 툴체인 ]
__pycache__/
*.py[cod]
.venv/

# [ 월드 빌드 산출물 ]
# .obj 는 Recast 입력용 중간 산출물이다(8MB). tools/build_collision.py 가 언제든
# 다시 만든다. .bin 과 .navmesh 는 서버가 실행할 때 필요하므로 커밋한다.
world/build/*.obj
